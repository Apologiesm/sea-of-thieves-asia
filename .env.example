# Copy to .env.local and fill with real values.
# NEVER commit .env.local. No secret belongs in frontend code.

# Public site URL (used for canonical URLs, sitemap, robots)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase local defaults (supabase start prints the exact values)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Discord application (Milestone 2 — unused in this build)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
BOOTSTRAP_ADMIN_DISCORD_IDS=
