# Copy to .env.local and fill with LOCAL values from `npx supabase start`.
# Never commit .env.local. Never put any key in frontend code.

# --- Public site -----------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Local Supabase (safe local development values only) -------------------
# Printed by `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never import this in a Client Component or a "use client" file.
# The anon key above is public by design; this key is not.
SUPABASE_SERVICE_ROLE_KEY=

# Protects /api/cron/sync-partner. Set a long random value in production.
CRON_SECRET=

# Protects POST /api/discord/events. Your Discord bot sends this as a bearer token.
DISCORD_EVENTS_SECRET=

# Discord role sync (bot token, not a webhook URL).
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ADMIN_ROLE_ID=
DISCORD_OWNER_ROLE_ID=

# Direct local database connection (server tooling / migrations only).
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Discord (Milestone 4; unused in this build) ---------------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
BOOTSTRAP_ADMIN_DISCORD_IDS=
